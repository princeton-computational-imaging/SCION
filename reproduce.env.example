# Copy to reproduce.env (gitignored); the Makefile reads it.

# Scene directories live at $DATA_ROOT/<scene>/ (default: data/ in the repo).
# scripts/download_data.sh keeps the archives in $DATA_ROOT/_archives/.
DATA_ROOT=data

# A pinned tmc3 (MPEG G-PCC, release-v23.0-rc2). Unset: scripts/setup/build_tmc13.sh
# finds or builds one on first need.
# TMC13_BINARY=/path/to/tmc3

# --backend slurm only. GRES and TIME are required; ACCOUNT / PARTITION / CPUS
# (cpus-per-task) / MEM are passed when set. MAXPAR caps concurrently running
# array tasks (default 16). A 30k-step job peaks at ~10 GB host RAM.
SLURM_ACCOUNT=
SLURM_PARTITION=
SLURM_CPUS=8
SLURM_MEM=48G
SLURM_GRES=gpu:1
SLURM_TIME=12:00:00
SLURM_MAXPAR=16
